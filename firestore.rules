rules_version = '2';

// Reglas reales de Firestore para Lula — reemplazan la regla temporal de "denegar todo" que
// se usó mientras no había ningún cliente escribiendo. Se pegan a mano en Firebase Console
// (Firestore Database → Reglas) porque no hay Firebase CLI instalado en este entorno; este
// archivo es la fuente de verdad versionada, la consola solo la refleja.
// Ver Plan/12-firebase-auth-y-sync.md.
//
// Nota importante: `de`/`para`/`usuarioA`/`usuarioB` son ids o contactos de la app (UUID local
// de Room, o un correo/teléfono en texto libre) — NO son el uid de Firebase Auth, son sistemas
// de identificación distintos. Por eso cada solicitud también guarda `deFirebaseUid` (el uid
// real de quien la creó) para que estas reglas puedan verificarla contra `request.auth.uid`.
// El lado del destinatario se valida con `request.auth.token.email` (el correo YA verificado
// por Firebase, no un dato que cualquiera podría inventar) comparado contra `para`.
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil mínimo (nombre, correo) — cualquier usuario autenticado puede leer cualquier
    // perfil (para mostrar "quién te invitó"), pero solo el dueño (mismo uid) escribe el suyo.
    match /usuarios/{firebaseUid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == firebaseUid;

      // Respaldo de lo Personal (Hábitos/Tareas + historial de racha) — a diferencia del
      // perfil, esto es privado: ni siquiera otro usuario autenticado puede leerlo, solo el
      // dueño de la cuenta. Ver `Plan/12-firebase-auth-y-sync.md`.
      match /actividadesPersonales/{actividadId} {
        allow read, write: if request.auth != null && request.auth.uid == firebaseUid;
      }
      match /registrosHabito/{registroId} {
        allow read, write: if request.auth != null && request.auth.uid == firebaseUid;
      }

      // Puntero liviano a cada Espacio Familia del que soy miembro — para descubrirlos en un
      // celular nuevo sin necesitar una collectionGroup query (necesitaría un índice compuesto
      // que no se puede crear sin Firebase CLI en este entorno). Ver
      // `Plan/12-firebase-auth-y-sync.md`.
      match /misEspacios/{espacioId} {
        allow read, write: if request.auth != null && request.auth.uid == firebaseUid;
      }

      // Ajustes de pantalla (barra inferior, duración de alarma, etc.) — subcolección aparte del
      // documento raíz a propósito, ver `CompartirSyncRepositoryImpl.subirAjustes`.
      match /ajustes/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == firebaseUid;
      }

      // Resto de lo Personal (Finanzas, Diario, Notas, Metas, Listas, Mi propósito) — mismo
      // patrón privado que arriba: solo el dueño de la cuenta lee/escribe. Ver
      // `Plan/12-firebase-auth-y-sync.md`.
      match /movimientosFinancieros/{movimientoId} {
        allow read, write: if request.auth != null && request.auth.uid == firebaseUid;
      }
      match /entradasDiario/{entradaId} {
        allow read, write: if request.auth != null && request.auth.uid == firebaseUid;
      }
      match /notas/{notaId} {
        allow read, write: if request.auth != null && request.auth.uid == firebaseUid;
      }
      match /metas/{metaId} {
        allow read, write: if request.auth != null && request.auth.uid == firebaseUid;
      }
      match /listas/{listaId} {
        allow read, write: if request.auth != null && request.auth.uid == firebaseUid;
      }
      match /proposito/{propositoId} {
        allow read, write: if request.auth != null && request.auth.uid == firebaseUid;
      }
      match /tomasMedicamento/{tomaId} {
        allow read, write: if request.auth != null && request.auth.uid == firebaseUid;
      }
      match /sesionesCita/{sesionId} {
        allow read, write: if request.auth != null && request.auth.uid == firebaseUid;
      }
      match /registrosDiarios/{registroId} {
        allow read, write: if request.auth != null && request.auth.uid == firebaseUid;
      }
      match /registrosSemanales/{registroId} {
        allow read, write: if request.auth != null && request.auth.uid == firebaseUid;
      }
      // Historial de "🔔 Notificaciones" — para que no se pierda al cambiar de celular. Ver
      // `Plan/08-decisiones-tecnicas.md`.
      match /notificaciones/{notificacionId} {
        allow read, write: if request.auth != null && request.auth.uid == firebaseUid;
      }
    }

    // Solicitudes de Círculo de cuidado: solo el remitente (deFirebaseUid) y el destinatario
    // (su correo verificado == para) pueden leer/actuar sobre una solicitud.
    match /solicitudes_compartir/{solicitudId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.deFirebaseUid || request.auth.token.email == resource.data.para);
      allow create: if request.auth != null &&
        (
          // Camino normal: quien comparte crea su propia solicitud (queda PENDIENTE).
          request.auth.uid == request.resource.data.deFirebaseUid ||
          // Camino QR: quien escanea un código de "Compartir seguimiento" ya vigente y a su
          // propio nombre crea la solicitud directamente ACEPTADA — el mismo id del documento
          // es el id del código (ver `codigosCompartirActividad`), así esta regla puede
          // verificar con get() que ese código de verdad fue reclamado por quien escribe, y que
          // el remitente declarado coincide con quien lo generó. Ver
          // `ReclamarCodigoCompartirActividadUseCase`/`Plan/08-decisiones-tecnicas.md`.
          (
            request.resource.data.estado == 'ACEPTADA' &&
            request.auth.token.email == request.resource.data.para &&
            get(/databases/$(database)/documents/codigosCompartirActividad/$(solicitudId)).data.reclamadoPor == request.auth.uid &&
            get(/databases/$(database)/documents/codigosCompartirActividad/$(solicitudId)).data.deFirebaseUid == request.resource.data.deFirebaseUid
          )
        );
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.deFirebaseUid || request.auth.token.email == resource.data.para);
      allow delete: if request.auth != null && request.auth.uid == resource.data.deFirebaseUid;
    }

    // Códigos de "Compartir seguimiento" (Círculo de cuidado) con tiempo de vida corto — mismo
    // patrón que `codigosInvitacionEspacio` de Familia: escanear une de inmediato, sin paso de
    // "aceptar" aparte, y el código solo sirve una vez (queda con `reclamadoPor` fijo).
    match /codigosCompartirActividad/{codigoId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.deFirebaseUid;
      allow read: if request.auth != null;
      allow update: if request.auth != null &&
        (
          // El dueño (quien comparte) puede seguir leyendo/gestionando su propio código.
          request.auth.uid == resource.data.deFirebaseUid ||
          // Quien escanea solo puede reclamarlo: sin reclamar, no vencido, y solo esos 3 campos.
          (
            resource.data.reclamadoPor == null &&
            request.time.toMillis() < resource.data.expiraEn &&
            request.resource.data.reclamadoPor == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reclamadoPor', 'reclamadoPorNombre', 'reclamadoPorCorreo'])
          )
        );
      allow delete: if request.auth != null && request.auth.uid == resource.data.deFirebaseUid;
    }

    // Conexion todavía no se lee en ninguna pantalla (ver Plan/10-pendientes.md) — regla
    // provisional, solo exige estar autenticado. Se endurece cuando de verdad se muestre en la
    // app (necesita guardar el uid de Firebase de ambos miembros, no solo su id local).
    match /conexiones/{conexionId} {
      allow read, write: if request.auth != null;
    }

    // Espacios Familia: contenido compartido (paso 5 del plan) — Tareas del hogar y Retos
    // familiares. `miembros` se guarda por uid de Firebase (no por el id local de la app) para
    // poder verificarlo acá — cada quien solo puede escribir su PROPIA membresía, nunca en
    // nombre de otro. El resto de las subcolecciones exige ser miembro (`esMiembro()`).
    match /espacios/{espacioId} {
      function esMiembro() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/espacios/$(espacioId)/miembros/$(request.auth.uid));
      }

      // Para "quitar a alguien de Familia" (admin) — necesita leer el ROL del propio requester,
      // no solo que exista como miembro. Ver `EliminarMiembroEspacioUseCase`.
      function esAdmin() {
        return request.auth != null &&
          get(/databases/$(database)/documents/espacios/$(espacioId)/miembros/$(request.auth.uid)).data.rol == 'ADMIN';
      }

      allow read: if esMiembro();
      // Cualquier autenticado puede crear un espacio nuevo (con su propio id, un UUID) — recién
      // ahí se agrega a sí mismo como miembro y empieza a poder leerlo.
      allow create: if request.auth != null;
      allow update, delete: if esMiembro();

      match /miembros/{miembroFirebaseUid} {
        allow read: if esMiembro();
        allow create: if request.auth != null && request.auth.uid == miembroFirebaseUid;
        // Uno mismo puede actualizar su propia fila (ej. nombre) libremente. Un admin además
        // puede "hacer admin" a otro miembro — pero SOLO ese campo (`rol`), nunca el nombre ni
        // nada más de otra persona. Ver `HacerAdminEspacioUseCase`.
        allow update: if request.auth != null &&
          (
            request.auth.uid == miembroFirebaseUid ||
            (esAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rol']))
          );
        // Salir del espacio (borrar la propia membresía) o que un admin quite a otra persona.
        allow delete: if request.auth != null && (request.auth.uid == miembroFirebaseUid || esAdmin());
      }

      match /actividades/{actividadId} {
        allow read, write: if esMiembro();
      }

      match /retos/{retoId} {
        allow read, write: if esMiembro();
      }

      match /registrosReto/{registroId} {
        allow read, write: if esMiembro();
      }
    }

    // Contenido real de una actividad compartida por Círculo de cuidado (a diferencia de
    // `solicitudes_compartir`, que es solo la "capa social") — un documento por solicitud ya
    // aceptada. Solo quien comparte escribe; quien comparte y a quien le comparten (por correo
    // verificado) pueden leer. Ver `Plan/08-decisiones-tecnicas.md`.
    match /actividadesCompartidas/{solicitudId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.deFirebaseUid || request.auth.token.email == resource.data.paraCorreo);
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.deFirebaseUid;
      // Además de quien comparte, quien lo recibe también puede borrar SU copia (por ejemplo,
      // "dejar de ver esto" sin esperar a que la otra persona revoque primero).
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.deFirebaseUid || request.auth.token.email == resource.data.paraCorreo);
    }

    // Código de invitación a un Espacio Familia con tiempo de vida corto (ver
    // `EspacioSyncRepository.generarCodigoInvitacion`) — escanearlo une a la persona de
    // inmediato, sin paso de aceptar aparte. `update` solo permite reclamarlo (fijar
    // `reclamadoPor` a mi propio uid) si nadie lo reclamó todavía y no venció — y ningún otro
    // campo puede cambiar en esa escritura. Así, aunque alguien guarde una foto del QR, ya no
    // sirve pasado el minuto de vida.
    match /codigosInvitacionEspacio/{codigoId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.deFirebaseUid;
      allow read: if request.auth != null;
      allow update: if request.auth != null &&
        resource.data.reclamadoPor == null &&
        request.time.toMillis() < resource.data.expiraEn &&
        request.resource.data.reclamadoPor == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reclamadoPor']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.deFirebaseUid;
    }

    // "Recordarle" (Círculo de cuidado, permiso PUEDE_VER_Y_RECORDAR) — quien acompaña crea el
    // aviso, solo quien comparte (a quien va dirigido) puede leerlo o borrarlo. No es push real,
    // solo se ve si la app de quien comparte está abierta/en memoria cuando llega. Ver
    // `Plan/08-decisiones-tecnicas.md`.
    match /recordatoriosSolicitados/{recordatorioId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.deFirebaseUid;
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.paraFirebaseUid;
    }

    // Cualquier otra colección no listada arriba: denegada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
